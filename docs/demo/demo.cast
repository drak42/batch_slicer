[9.347687, "o", "============================================================\r\n\r\nBatchSlicer v0.16.1\r\n\r\nPrint Automation Platform\r\n\r\nPython 3.12+\r\n\r\n============================================================\r\n"]
[9.35097, "o", "Using profile 'k2': orca, Creality K2 Plus 0.4 nozzle, Generic PETG @K2 Plus-all, 0.20mm Standard @Creality K2 Plus 0.4 nozzle, send to 192.168.1.242, output /home/chris/demo/output, models together on plates, colours matched to the loaded filaments\r\n"]
[9.52866, "o", "BatchSlicer ready. Slicer: OrcaSlicer.\r\n  Printer:  Creality K2 Plus 0.4 nozzle\r\n  Filament: Generic PETG @K2 Plus-all\r\n  Process:  0.20mm Standard @Creality K2 Plus 0.4 nozzle\r\n  Send to:  192.168.1.242 (http://192.168.1.242:7125)\r\n  Options:  each folder's models together on plates\r\n"]
[9.529003, "o", "\r\nDry run: nothing is sliced, written or sent.\r\n\r\n"]
[9.858969, "o", "Printer 192.168.1.242 (http://192.168.1.242:7125) answers.\r\n"]
[9.941187, "o", "Would slice 1 model file from /home/chris/demo/kits:\r\n"]
[9.942581, "o", "  bumper.3mf\r\n      multi-colour project with 2 filaments:\r\n        slot 1 (black PETG) -> CFS 1B dark blue PETG\r\n        slot 2 (white PETG) -> external spool white PETG\r\n"]
[9.942724, "o", "Results would go to /home/chris/demo/output/bumper-<date>-<time> (with the G-code inside).\r\nThen the G-code would be sent to 192.168.1.242 (http://192.168.1.242:7125).\r\n\r\nRun the same command without --dry-run to do it.\r\n"]
